# Path to the Stockfish executable binary (Linux default provided by apt-get)
STOCKFISH_PATH=/usr/games/stockfish

# Comma-separated list of allowed origins for CORS (optional: defaults to local dev URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of concurrent Stockfish instances in the pool (default: 4)
ENGINE_POOL_SIZE=4

# Logging verbosity level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
